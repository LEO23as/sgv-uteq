# Copia este archivo como .env y rellena los valores reales
# cp .env.example .env

# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga
DEBUG=True

# Base de datos PostgreSQL
# ── Base de datos LOCAL (Docker) — activa ──
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Correo institucional (Google Workspace) — envío de credenciales y reseteo de claves
# EMAIL_HOST_PASSWORD debe ser una "Contraseña de aplicación" de Google (16 caracteres, sin espacios)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tucorreo@uteq.edu.ec
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion
DEFAULT_FROM_EMAIL=tucorreo@uteq.edu.ec
